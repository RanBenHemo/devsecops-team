# Copy this file to .env and fill in only the keys you have. Never commit .env.
# In Google Colab, put the same names in Colab Secrets instead.
# Without any key the project runs with the scripted model (--model scripted, the default).

# pen_tester (Groq)
GROQ_API_KEY=
# developer (Gemini)
GEMINI_API_KEY=
# tester (OpenRouter)
OPENROUTER_API_KEY=

# Optional: another model id per provider. Empty means the default in models/llm_adapter.py.
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
